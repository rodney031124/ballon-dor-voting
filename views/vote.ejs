<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0c0c0b">
    <title>Your Ballot — Ballon d'Or 2026</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body class="app-page">
    <header class="site-header">
      <a class="wordmark" href="/vote"><span class="wordmark-mark">B</span> BALLON D'OR <span class="wordmark-year">2026</span></a>
      <a class="text-button admin-link" href="/admin">Admin <span aria-hidden="true">↗</span></a>
    </header>

    <main class="ballot-main">
      <div class="ballot-heading">
        <div>
          <p class="eyebrow"><span class="live-dot"></span> THE PEOPLE'S BALLOT <span class="separator">/</span> SCHOOL SHORTLIST</p>
          <h1>Who gets <span>your vote?</span></h1>
          <p class="heading-copy">Choose your winner. One vote per device.</p>
        </div>
        <div class="vote-counter"><span>YOUR BALLOT</span><strong>00<small> / 01</small></strong></div>
      </div>

      <p class="form-error ballot-error" id="form-error" role="alert" <%= error ? "" : "hidden" %>><%= error || "" %></p>
      <div class="loading" id="status-loading" role="status">Checking this device...</div>
      <div class="form-error device-error" id="device-error" role="alert" hidden>
        <span id="device-error-message">We couldn't check this device.</span>
        <button class="retry-button" id="retry-status" type="button">Try again</button>
      </div>

      <section class="success-card" id="success-card" role="status" hidden>
        <div class="success-icon" aria-hidden="true">✓</div>
        <div><p class="eyebrow">BALLOT RECEIVED</p><h2>Your vote is in.</h2><p>Thank you for taking part. This device has already submitted its vote.</p></div>
        <span class="success-seal">ONE<br>VOTE<br>CAST</span>
      </section>

      <div id="ballot-content" hidden>
        <form action="/vote" method="post" id="ballot-form">
          <input type="hidden" name="deviceId" id="device-id">
          <div class="nominee-grid">
            <% nominees.forEach((nominee, index) => { %>
              <label class="nominee-card<%= selectedId === nominee.id ? " is-selected" : "" %>" for="nominee-<%= nominee.id %>">
                <input id="nominee-<%= nominee.id %>" type="radio" name="nominee" value="<%= nominee.id %>" <%= selectedId === nominee.id ? "checked" : "" %> required>
                <span class="card-number"><%= String(index + 1).padStart(2, "0") %></span>
                <span class="player-avatar nominee-photo avatar-<%= nominee.color %>">
                  <% if (nominee.image) { %>
                    <img src="<%= nominee.image %>" alt="" loading="lazy" decoding="async">
                  <% } else { %>
                    <span><%= nominee.initials %></span>
                  <% } %>
                </span>
                <span class="player-info"><strong><%= nominee.name %></strong><span>Ballot nominee</span></span>
                <span class="select-indicator" aria-hidden="true">✓</span>
              </label>
            <% }) %>
          </div>
          <div class="submit-bar">
            <p><span class="lock-icon" aria-hidden="true">◇</span> One vote per browser device. Your choice stays private.</p>
            <button class="button button-gold submit-button" type="submit">Submit final vote <span aria-hidden="true">→</span></button>
          </div>
        </form>
      </div>
      <p class="shortlist-disclaimer">One vote per browser storage. Clearing browser data or switching devices may allow another vote.</p>
    </main>
    <footer class="site-footer"><span>THE BEAUTIFUL GAME, CELEBRATED</span><a href="/admin">ADMIN</a><span>© 2026</span></footer>
    <script src="/ballot.js" defer></script>
  </body>
</html>
